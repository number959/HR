[Unit]
Description=NefroCenter Persone e Presenze Web
After=network.target

[Service]
Type=simple
User=presenze-web
Group=presenze-web
WorkingDirectory=/opt/presenze-web
EnvironmentFile=/etc/presenze-web/presenze.env
ExecStart=/opt/presenze-web/.venv/bin/python /opt/presenze-web/web_server.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/presenze-web

[Install]
WantedBy=multi-user.target
