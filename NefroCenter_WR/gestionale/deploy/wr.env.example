# Configurazione del servizio (copiare in /etc/nefrocenter-wr/wr.env, leggibile solo dall'utente del servizio).
# Nessuna password qui dentro, tranne quella della posta quando il servizio aziendale sarà configurato.
WR_ORIGIN=https://wr.esempio.it
WR_DATA_DIR=/var/lib/nefrocenter-wr
WR_KEY_FILE=/etc/nefrocenter-wr/server.key
WR_PORT=8080
TZ=Europe/Rome
# Password dell'account di posta: da impostare solo dopo aver concordato il servizio SMTP aziendale.
# WR_SMTP_PASSWORD=
